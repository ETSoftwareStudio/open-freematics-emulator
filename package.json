{
  "name": "@fme/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.ts",
    "dev:rs": "node scripts/dev-runner.ts --rust",
    "dev:server": "vp run --filter @fme/server dev",
    "dev:web": "vp run --filter @fme/web dev",
    "build": "vp run --filter @fme/web build && vp run --filter @fme/server build",
    "start": "vp run --filter @fme/server start",
    "desktop": "vp run build && vp run --filter @fme/desktop build && vp run --filter @fme/desktop start",
    "desktop:dev": "node scripts/dev-runner.ts --desktop",
    "desktop:dist": "vp run build && vp run --filter @fme/desktop build && vp run --filter @fme/desktop dist --",
    "npm:stage": "vp run build && node apps/server/scripts/stage-npm.ts",
    "npm:smoke": "node apps/server/scripts/smoke-npm.ts",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "sync:repos": "sh scripts/sync-reference-repos.sh",
    "rs:fixtures": "node packages/shared/scripts/rust-fixtures.ts && vp fmt crates/fme-core/tests/fixtures",
    "rs:check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "check": "vp fmt --check && vp lint && vp run -r typecheck && vp run -r test && vp run rs:check",
    "hardware:check": "node apps/server/scripts/hardware-check.ts",
    "conformance": "node apps/server/scripts/conformance.ts"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.10"
  },
  "packageManager": "pnpm@12.15.0"
}
